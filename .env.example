# Copy to .env (gitignored) and adjust. Values below are for the local Compose network (spec section 6).
# Hostnames are Compose service names; from the host shell use localhost and the published ports instead.
# Nothing here is a real secret: dev API keys are placeholders, and real keys come from a secret store.

# --- Postgres 18 ---
DATABASE_URL=postgresql://gateway:gateway@postgres:5432/gateway
POSTGRES_USER=gateway
POSTGRES_PASSWORD=gateway
POSTGRES_DB=gateway
# API connection pool (the poller uses its own single connection).
DB_POOL_SIZE=10

# --- SFTP drop (AS/400 stand-in) ---
SFTP_HOST=sftp
SFTP_PORT=22
SFTP_USER=gateway
SFTP_REMOTE_DIR=/outbound/shipments
SFTP_KEY_PATH=/run/secrets/gateway_ed25519
# Pinned host key, recorded under the name "sftp" (not [localhost]:2222); see spec section 12.
SFTP_KNOWN_HOSTS=/run/secrets/known_hosts
# Only when running on the host against localhost:2222 (make poll-local sets it): look the key up as "sftp".
# SFTP_HOST_KEY_ALIAS=sftp
# FR-1 says 60 s; the demo overrides this to 5.
SFTP_POLL_INTERVAL_S=60
INGEST_BATCH_SIZE=1000
# Where python -m gateway.migrate finds NNNN_*.sql (relative to the working directory).
MIGRATIONS_DIR=migrations

# --- SOAP rate-quote service ---
SOAP_BASE_URL=http://soap-mock:8080
# Bulkhead size (ADR-P01-1): Meridian allows 5, we take 4 and leave 1 for their own callers.
SOAP_MAX_CONCURRENCY=4
# How long a request waits for a bulkhead slot before a fast 503 (spec M5: 0.2 s).
SOAP_BULKHEAD_WAIT_S=0.2
# Circuit breaker: open after 5 consecutive retryable failures, try again after 30 s.
BREAKER_FAILURE_THRESHOLD=5
BREAKER_RESET_AFTER_S=30

# --- Webhooks ---
# Retry horizon before dead-lettering: 72h in production, 120s for the M7 demo.
WEBHOOK_MAX_AGE=72h
WEBHOOK_TIMEOUT_S=5
# Full jitter from 30 s, doubling to a 6 h cap (spec M7).
WEBHOOK_BASE_DELAY_S=30
WEBHOOK_MAX_DELAY_S=21600
WEBHOOK_POLL_INTERVAL_S=1
WEBHOOK_BATCH_SIZE=50
# LAB ONLY (never in production): exact hostnames that skip the SSRF address check, and the CA the
# dispatcher trusts for the local sink. `make api-local` / `make dispatch-local` set them for you.
# WEBHOOK_DEV_ALLOW_HOSTS=localhost
# WEBHOOK_CA_BUNDLE=secrets/webhook-ca.crt

# --- API keys (dev only). `make dev-keys` stores their SHA-256 hashes: shipper -> ACME, ops -> meridian-ops ---
DEV_SHIPPER_API_KEY=dev-shipper-key
DEV_OPS_API_KEY=dev-ops-key

# --- Telemetry (section 8) ---
OTEL_SERVICE_NAME=meridian-gateway
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-lgtm:4317
OTEL_SEMCONV_STABILITY_OPT_IN=http

# --- Image tag for deploy and rollback (section 6) ---
GATEWAY_TAG=dev

# --- Lab only ---
# SOAP mock latency (spec: Meridian p99 is 2.8 s; M5/M9 load tests set 2800).
SOAP_MOCK_LATENCY_MS=300
# CA bundle of a TLS-inspecting egress proxy, mounted only at image BUILD time (never in a layer).
# Claude Code cloud VM: /root/.ccr/ca-bundle.crt. Leave unset elsewhere.
# BUILD_CA_BUNDLE=/root/.ccr/ca-bundle.crt
